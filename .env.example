# Required in Vercel production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELIANT_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=

# Optional. Vercel uses /tmp by default, which is ephemeral between invocations.
# Set this only when using a durable mounted filesystem outside standard Vercel functions.
RELIANT_DATA_FILE=

# Optional BOT Chain receipt configuration
BOT_TESTNET_CHAIN_ID=968
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_TESTNET_EXPLORER=https://scan.bohr.life